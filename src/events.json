{
  "logs": [
    { "id": "application", "names": ["Application"], "lookback": true },
    { "id": "system", "names": ["System"], "lookback": true },
    { "id": "printservice", "names": ["Microsoft-Windows-PrintService/Admin"], "lookback": true },
    { "id": "smbclient", "names": ["Microsoft-Windows-SMBClient/Connectivity"], "lookback": true },
    { "id": "profileservice", "names": ["Microsoft-Windows-User Profile Service/Operational"], "lookback": true },
    { "id": "session", "names": ["Microsoft-Windows-TerminalServices-LocalSessionManager/Operational"], "lookback": false },
    { "id": "defender", "names": ["Microsoft-Windows-Windows Defender/Operational"], "lookback": true },
    { "id": "applocker", "names": ["Microsoft-Windows-AppLocker/EXE and DLL", "Microsoft-Windows-AppLocker/MSI and Script"], "lookback": true }
  ],
  "events": [
    { "log": "application", "provider": "Application Error", "ids": [1000], "group": "app", "kind": "crash",
      "fields": { "app": ["AppName", "#0"], "appVersion": ["AppVersion", "#1"], "module": ["ModuleName", "#3"], "moduleVersion": ["ModuleVersion", "#4"],
        "code": ["ExceptionCode", "#6"], "pid": { "field": ["ProcessId", "#8"], "format": "hex" }, "processStart": ["ProcessCreationTime", "#9"] } },
    { "log": "application", "provider": "Application Hang", "ids": [1002], "group": "app", "kind": "hang",
      "fields": { "app": "#0", "appVersion": "#1", "pid": { "field": "#2", "format": "hex" }, "processStart": "#3" } },
    { "log": "application", "provider": ".NET Runtime", "ids": [1026], "group": "app", "kind": "app-detail" },
    { "log": "application", "provider": "Windows Error Reporting", "ids": [1001], "group": "app", "kind": "app-detail" },
    { "log": "application", "provider": "Microsoft-Windows-User Profiles Service", "ids": [1500, 1502, 1508, 1511, 1515, 1533], "group": "profile", "kind": "profileerror" },
    { "log": "profileservice", "provider": "Microsoft-Windows-User Profiles Service", "ids": [1500, 1502, 1508, 1511, 1515, 1533], "group": "profile", "kind": "profileerror" },
    { "log": "application", "provider": "Citrix Profile Management", "ids": "*", "levels": ["error", "warning"], "group": "profile", "kind": "profileerror" },
    { "log": "system", "provider": "Service Control Manager", "ids": [7023, 7031, 7034], "group": "service", "kind": "service",
      "fields": { "service": "binary:utf16" } },
    { "log": "system", "provider": "disk", "ids": [7, 11, 51, 153], "group": "storage", "kind": "system",
      "fields": { "object": "#0" } },
    { "log": "system", "provider": "Ntfs", "ids": [55, 98, 137, 140], "group": "storage", "kind": "system",
      "fields": { "object": "#0" } },
    { "log": "system", "provider": "Microsoft-Windows-Resource-Exhaustion-Detector", "ids": [2004], "group": "memory", "kind": "system" },
    { "log": "printservice", "provider": "Microsoft-Windows-PrintService", "ids": [372, 808, 6161], "group": "print", "kind": "print" },
    { "log": "printservice", "provider": "Microsoft-Windows-PrintService", "ids": [600, 601], "group": "print", "kind": "print",
      "fields": { "driver": "Driver" } },
    { "log": "printservice", "provider": "Microsoft-Windows-PrintService", "ids": [215], "group": "print", "kind": "print",
      "fields": { "driver": "DriverName" } },
    { "log": "smbclient", "provider": "Microsoft-Windows-SMBClient", "ids": [30800, 30803, 30804, 30805, 30806, 30807], "group": "fileserver", "kind": "system",
      "fields": { "object": "ServerName" } },
    { "log": "session", "provider": "Microsoft-Windows-TerminalServices-LocalSessionManager", "ids": [21], "group": "session", "kind": "logon",
      "fields": { "user": "User", "session": "SessionID" } },
    { "log": "session", "provider": "Microsoft-Windows-TerminalServices-LocalSessionManager", "ids": [23], "group": "session", "kind": "logoff",
      "fields": { "user": "User", "session": "SessionID" } },
    { "log": "session", "provider": "Microsoft-Windows-TerminalServices-LocalSessionManager", "ids": [24], "group": "session", "kind": "disconnect",
      "fields": { "user": "User", "session": "SessionID" } },
    { "log": "session", "provider": "Microsoft-Windows-TerminalServices-LocalSessionManager", "ids": [25], "group": "session", "kind": "reconnect",
      "fields": { "user": "User", "session": "SessionID" } },
    { "log": "defender", "provider": "Microsoft-Windows-Windows Defender", "ids": [1000], "group": "security", "kind": "scan-start" },
    { "log": "defender", "provider": "Microsoft-Windows-Windows Defender", "ids": [1001, 1002], "group": "security", "kind": "scan-end" },
    { "log": "defender", "provider": "Microsoft-Windows-Windows Defender", "ids": [2000], "group": "security", "kind": "signature-update" },
    { "log": "applocker", "provider": "Microsoft-Windows-AppLocker", "ids": [8004, 8007], "group": "security", "kind": "applocker-block" }
  ],
  "importantServices": ["Spooler", "ctxProfile", "BrokerAgent", "CitrixPrintManagerService"],
  "printProcesses": ["spoolsv.exe", "PrintIsolationHost.exe"],
  "printServices": ["Spooler"],
  "nonPersonAccounts": ["SYSTEM", "LOCAL SERVICE", "NETWORK SERVICE", "LOKALER DIENST", "NETZWERKDIENST", "DWM-*", "UMFD-*", "ANONYMOUS LOGON", "ANONYMOUS-ANMELDUNG", "*$"],
  "nonPersonDomains": ["NT SERVICE", "IIS APPPOOL", "NT AUTHORITY", "NT-AUTORITÄT", "Window Manager", "Font Driver Host"],
  "systemModules": ["ntdll.dll", "KERNELBASE.dll", "kernel32.dll", "user32.dll", "win32u.dll", "gdi32.dll", "gdi32full.dll", "combase.dll", "ole32.dll",
    "oleaut32.dll", "rpcrt4.dll", "shell32.dll", "shlwapi.dll", "msvcrt.dll", "ucrtbase.dll", "VCRUNTIME*.dll", "MSVCP*.dll", "msvcr*.dll", "mfc*.dll",
    "clr.dll", "clrjit.dll", "coreclr.dll", "mscorlib.ni.dll", "mscorwks.dll"],
  "noModules": ["unknown", "StackHash_*"],
  "errorCodes": [
    { "code": "0xc0000005", "text": "Zugriffsverletzung" },
    { "code": "0xc00000fd", "text": "Stapelüberlauf" },
    { "code": "0xc0000017", "text": "Speicheranforderung fehlgeschlagen" },
    { "code": "0xc0000409", "text": "Pufferüberlauf erkannt, Programm vom System beendet" },
    { "code": "0xc0000374", "text": "Heap beschädigt" },
    { "code": "0xe0434352", "text": "unbehandelte .NET-Ausnahme" },
    { "code": "0x80000003", "text": "Haltepunkt erreicht (Programmfehler)" },
    { "code": "0xc0000135", "text": "benötigte DLL nicht gefunden" },
    { "code": "0xc0000142", "text": "Initialisierung einer DLL fehlgeschlagen" },
    { "code": "AppHangB1", "text": "wegen Nichtreagierens beendet" }
  ]
}
